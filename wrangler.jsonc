{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amazoniadb",
  "main": "worker.js",
  "compatibility_date": "2026-08-17",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
